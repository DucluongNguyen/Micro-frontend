{
  "name": "about-remote",
  "version": "1.0.0",
  "description": "About remote (Module Federation), written in TypeScript.",
  "private": true,
  "scripts": {
    "start": "cross-env NODE_ENV=development rspack serve --mode development --port 3010",
    "build": "rspack build --mode production",
    "build:sit": "cross-env NODE_ENV=sit rspack build --mode production",
    "build:uat": "cross-env NODE_ENV=uat rspack build --mode production",
    "build:staging": "cross-env NODE_ENV=staging rspack build --mode production",
    "build:prod": "cross-env NODE_ENV=production rspack build --mode production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss,json}\""
  },
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "antd": "^5.24.9",
    "axios": "^1.9.0",
    "dayjs": "^1.11.21",
    "formik": "^2.4.9",
    "lodash": "^4.18.1",
    "query-string": "^9.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-query": "^3.39.3",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.28.0",
    "yup": "^1.7.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@module-federation/enhanced": "^0.15.0",
    "@rspack/cli": "^1.4.1",
    "@rspack/core": "^1.4.1",
    "@rspack/plugin-react-refresh": "^1.5.2",
    "@types/lodash": "^4.17.25",
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.5",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "dotenv-flow": "^4.1.0",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "postcss-loader": "^8.1.1",
    "prettier": "^3.5.3",
    "react-refresh": "^0.18.0",
    "sass": "^1.87.0",
    "sass-loader": "^16.0.5",
    "style-loader": "^4.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.0"
  }
}
